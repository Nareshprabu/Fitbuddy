# ==============================================================================
# FitBuddy AI - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection
# Gemini 1.5 Pro: High-reasoning model for complex 7-day workout plans & feedback iteration
GEMINI_WORKOUT_MODEL=gemini-1.5-pro

# Gemini Flash: Ultra-fast model for rapid nutrition & recovery guidance
GEMINI_NUTRITION_MODEL=gemini-1.5-flash

# SQLite Database Location
DATABASE_URL=sqlite:///./fitbuddy.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
